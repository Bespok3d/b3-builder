          "mode": "644"
        }
      ]
    }
  },
  "tun-module-0.1.0.b3": {
    "entries": [
      {
        "path": "doc/CHANGELOG.md",
        "sha256": "337d9903526c096800da5ce918009f1f8a3c91cb20021dcb4d926aefc11434bb"
      },
      {
        "path": "doc/README.md",
        "sha256": "59263519bbc235c76b966b5baff172d30c6d4a7e14f2d1171ac1d30239e73234"
      },
      {
        "path": "files/modules/tun-6.1.99.ko",
        "sha256": "5d4649035f12563831b9c529e5dc6dd13e220b624c19cd217cc54d19c217df69"
      }
    ],
    "manifest": {
      "name": "tun-module",
      "title": "TUN kernel module",
      "version": "0.1.0",
      "author": "bespoked",
      "description": "Loads the Linux `tun` kernel module so the printer has a working /dev/net/tun. Mesh-VPN plugins (ZeroTier needs it; Tailscale runs lighter with it) build a virtual network interface on top of it. The Snapmaker U1's stock kernel ships tun neither built in nor as a module, so this plugin carries a `tun.ko` cross-built against the exact running kernel (6.1.99 aarch64) and insmods it at boot, before the services that need it. Nothing to configure: install it (or install a VPN plugin that requires it) and /dev/net/tun is there.",
      "tagline": "Adds /dev/net/tun to the printer, the base a mesh VPN builds on.",
      "category": "system",
      "channel": "testing",
      "printer_specific": true,
      "changelog": "doc/CHANGELOG.md",
      "published_at": "2026-07-05",
      "updated_at": "2026-07-05",
      "source": "https://github.com/bespok3d-org/plugin-networking",
      "publisher": "PLACEHOLDER",
      "provides": [
        {
          "service": "tun"
        }
      ],
      "require": [],
      "conflicts": [],
      "requires": {
        "capabilities": [
          "kernel-modules"
        ],
        "variables": []
      },
      "permissions": [
        "kernel-module"
      ],
      "config": [],
      "install": {
        "place": [
          {
            "class": "kernel-module",
            "name": "tun.ko",
            "variants": [
              {
                "when": {
                  "kernel_release": "6.1.99"
                },
                "src": "files/modules/tun-6.1.99.ko"
              }
            ]
          }
        ],
        "kmodule": [
          {
            "name": "tun",
            "module": "tun.ko",
            "device_nodes": [
              "/dev/net/tun c 10 200"
            ],
            "autoload": true
          }
        ]
      },
      "stop": [],
      "endpoints": [],
      "conflict_resolutions": [],
      "files": [
        {
          "path": "files/modules/tun-6.1.99.ko",
          "sha256": "5d4649035f12563831b9c529e5dc6dd13e220b624c19cd217cc54d19c217df69",
          "mode": "644"
        }
      ]
    }
  },
