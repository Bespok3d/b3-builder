    "manifest": {
      "name": "tailscale",
      "title": "Tailscale",
      "version": "0.1.1",
      "sw_version": "1.98.8",
      "author": "bespoked",
      "description": "Joins the printer to your Tailscale mesh network (tailnet), so you can reach Fluidd/Mainsail, the camera, and SSH from anywhere without opening a port on your router. Bring your own account: generate an auth key at login.tailscale.com/admin/settings/keys, then paste it below. The printer authorizes itself the way any Tailscale device does; it appears in your tailnet's device list like a laptop or phone. Bespok3d hosts no coordination service and never sees your auth key or traffic. Runs tailscaled as a managed service on top of the tun-module base (a real /dev/net/tun the tailscale0 network interface needs).",
      "tagline": "Reach your printer from anywhere over your Tailscale network.",
      "category": "system",
      "channel": "experiment",
      "printer_specific": false,
      "changelog": "doc/CHANGELOG.md",
      "published_at": "2026-07-05",
      "updated_at": "2026-07-05",
      "source": "https://github.com/bespok3d-org/plugin-networking",
      "publisher": "PLACEHOLDER",
      "provides": [
        {
          "service": "tailscale"
        }
      ],
      "require": [
        {
          "service": "tun",
          "cardinality": "one"
        }
      ],
      "conflicts": [],
      "requires": {
        "capabilities": [
          "klipper-generic"
        ],
        "variables": [
          {
            "name": "TS_AUTHKEY",
            "description": "An auth key from your tailnet's admin console (login.tailscale.com/admin/settings/keys), starting with tskey-auth-.",
            "required": true
          }
        ]
      },
      "permissions": [
        "system-bin",
        "managed-service",
        "moonraker-config",
        "restart"
      ],
      "config": [
        {
          "key": "TS_AUTHKEY",
          "label": "Tailscale auth key",
          "type": "text",
          "placeholder": "tskey-auth-...",
          "hint": "From your tailnet's admin console (login.tailscale.com/admin/settings/keys, then Generate auth key; a brand-new account lands on an 'add a device' wizard first, open the keys page directly). Turn on Reusable: a reusable key lets you reinstall without generating a new one, and one reusable key can join several printers (each appears as its own device). Bring your own account; Bespok3d hosts nothing.",
          "required": true,
          "scope": "global",
          "userEditable": true
        }
      ],
      "install": {
        "data": [
          "tailscale"
        ],
        "templates": [
          {
            "from": "files/authkey.tmpl",
            "to": "authkey"
          }
        ],
        "place": [
          {
            "class": "system-bin",
            "name": "tailscaled",
            "variants": [
              {
                "when": {
                  "arch": "aarch64"
                },
                "src": "files/bin/tailscaled-aarch64"
              }
            ]
          },
          {
            "class": "system-bin",
            "name": "tailscale",
            "variants": [
              {
                "when": {
                  "arch": "aarch64"
                },
                "src": "files/bin/tailscale-aarch64"
              }
            ]
          },
          {
            "class": "system-bin",
            "src": "files/bin/ts-run"
          },
          {
            "class": "moonraker-config",
            "src": "files/cfg/moonraker/tailscale-trusted.cfg",
            "name": "tailscale-trusted.cfg"
          }
        ],
        "service": [
          {
            "name": "tailscale",
            "command": "$BESPOK3D/bin/ts-run",
            "args": [
              "$BESPOK3D/var/lib/tailscale",
              "$BESPOK3D_PLUGINS/tailscale/authkey"
            ],
            "autostart": true
          }
        ],
        "restart": [
          "moonraker"
        ]
      },
      "conflict_resolutions": [],
      "files": [
        {
          "path": "files/authkey.tmpl",
          "sha256": "1af6eaa460c33070c748255b11d6a96453af9ee1016deb224246fd0313171a33",
          "mode": "644"
        },
        {
