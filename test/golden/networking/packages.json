    "manifest": {
      "name": "zerotier",
      "title": "ZeroTier",
      "version": "0.1.1",
      "sw_version": "1.16.2",
      "author": "bespoked",
      "description": "Joins the printer to a ZeroTier mesh network, so you can reach Fluidd/Mainsail, the camera, and SSH from anywhere without opening a port on your router. Bring your own account: create a free network at my.zerotier.com, then paste its 16-hex-digit network id below. The printer authorizes itself the way any ZeroTier device does; approve it in ZeroTier Central like you would a laptop or phone. Bespok3d hosts no coordination service and never sees your network id or traffic. Runs zerotier-one as a managed service on top of the tun-module base (a real /dev/net/tun the ZeroTier virtual network interface needs).",
      "tagline": "Reach your printer from anywhere over a ZeroTier mesh network.",
      "category": "system",
      "channel": "testing",
      "printer_specific": false,
      "changelog": "doc/CHANGELOG.md",
      "published_at": "2026-07-05",
      "updated_at": "2026-07-05",
      "source": "https://github.com/bespok3d-org/plugin-networking",
      "publisher": "PLACEHOLDER",
      "provides": [
        {
          "service": "zerotier"
        }
      ],
      "require": [
        {
          "service": "tun",
          "cardinality": "one"
        }
      ],
      "conflicts": [],
      "requires": {
        "capabilities": [
          "klipper-generic"
        ],
        "variables": [
          {
            "name": "ZT_NETWORK_ID",
            "description": "The 16 hex digit ZeroTier network id to join, from your ZeroTier Central account (my.zerotier.com).",
            "required": true
          }
        ]
      },
      "permissions": [
        "system-bin",
        "managed-service"
      ],
      "config": [
        {
          "key": "ZT_NETWORK_ID",
          "label": "ZeroTier network id",
          "type": "text",
          "placeholder": "a09acf02338597c4",
          "hint": "16 hex digits, from your ZeroTier Central account (my.zerotier.com). Bring your own network; Bespok3d hosts nothing. After install, approve the printer's device in ZeroTier Central.",
          "required": true,
          "scope": "global",
          "userEditable": true
        }
      ],
      "install": {
        "data": [
          "zerotier"
        ],
        "templates": [
          {
            "from": "files/network-id.tmpl",
            "to": "network-id"
          }
        ],
        "place": [
          {
            "class": "system-bin",
            "name": "zerotier-one",
            "variants": [
              {
                "when": {
                  "arch": "aarch64"
                },
                "src": "files/bin/zerotier-one-aarch64"
              }
            ]
          },
          {
            "class": "system-bin",
            "src": "files/bin/zt-run"
          }
        ],
        "service": [
          {
            "name": "zerotier",
            "command": "$BESPOK3D/bin/zt-run",
            "args": [
              "$BESPOK3D/var/lib/zerotier",
              "$BESPOK3D_PLUGINS/zerotier/network-id"
            ],
            "autostart": true
          }
        ]
      },
      "conflict_resolutions": [],
